* PM28 uvlo: slow input ramp 0 -> 20 V -> 0, turn-on and turn-off thresholds
.include models.lib
.lib LTC4364-2.sub
.lib LT8641.sub
.lib LTC3.lib
.lib standard.mos
.lib standard.dio
VS SRCV 0 PWL(0 0 100m 20 200m 0)
RSRC SRCV IN 10m
RF1 IN NF 0.1
XD1 NF 0 SMCJ58CA
M1 NF HG SRC SRC IPB072N15N3
M2 SNS DG SRC SRC BSC060N10NS3
RSNS SNS VBUS 0.02
RHG HG HGP 10
CHG HGP 0 2.2e-09
D2 NF VD BAS21HY
RUV1 VD UV 1.05e+06
RUV2 UV 0 100000
RVCC VD VCC 1000
CVCC VCC 0 1e-07
DZ1 0 VCC MMSZ5265B
RFB1 VBUS FB 147000
RFB2 FB 0 4990
CTMR TMR 0 6.8e-06
XU1 VBUS SNS DG SRC HGP VCC VCC UV 0 0 FLT ENOUT TMR FB LTC4364-2
RFLT FLT V3 100k
RENO ENOUT VBUS 100k
CBUS VBUS 0 4.7e-05 Rser=0.3
V3 V3 0 3.3
RLD VBUS 0 28
.tran 0 200m 0 20u
.save V(IN) V(NF) V(SRC) V(VBUS) V(TMR) V(FLT) V(ENOUT) V(HGP) V(VCC) I(RF1) I(RSNS) Id(M1) Id(M2) V(SNS)
.end
